{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/index.ts",
    "src/HtmlSurfaceManager.ts",
    "src/core/**/*.ts",
    "src/backends/**/*.ts"
  ],
  "exclude": [
    "src/demo"
  ]
}
