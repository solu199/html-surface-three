{
  "name": "html-surface-three",
  "version": "0.1.0-rc.2",
  "private": false,
  "type": "module",
  "description": "Manage interactive HTML UI as Three.js mesh surfaces with texture rendering, UV mapping, occlusion-aware input, and lifecycle control.",
  "license": "MIT",
  "author": "HTML Surface Three contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solu199/html-surface-three.git"
  },
  "bugs": {
    "url": "https://github.com/solu199/html-surface-three/issues"
  },
  "homepage": "https://solu199.github.io/html-surface-three/",
  "keywords": [
    "three.js",
    "html",
    "texture",
    "webgl",
    "interaction",
    "react",
    "canvas",
    "3d-ui"
  ],
  "main": "./dist/html-surface-three.js",
  "module": "./dist/html-surface-three.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/html-surface-three.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:tier1": "playwright test tests/e2e/tier1.spec.ts",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:evidence": "playwright test tests/e2e/tier1.spec.ts --config=playwright.evidence.config.ts --project=chrome --grep \"移動・回転後\"",
    "test:visual": "playwright test tests/e2e/visual.spec.ts --project=chrome",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "vite build",
    "build:pages": "vite build --base=/html-surface-three/",
    "build": "npm run build:lib && npm run build:demo",
    "release:info": "node scripts/release-info.mjs",
    "verify:package": "npm run build:lib && node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:package",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "three": ">=0.184.0 <0.186.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "three-html-render": "^0.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "^20.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
